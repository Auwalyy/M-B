# Copy to apps/api/.env and adjust. Never commit the real .env file.

NODE_ENV=development
PORT=4100
LOG_LEVEL=info

# MongoDB must be a replica set (transactions are required).
# Local: `npm run db:dev` (no Docker) or `docker compose up mongo`. Production: MongoDB Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/mudassir?replicaSet=rs0

# Public URL of the web app (used for CORS, email links and the CSRF origin check).
WEB_URL=http://localhost:3000
# Extra allowed origins, comma separated (e.g. a staging domain).
CORS_ORIGINS=http://127.0.0.1:3000
# Number of reverse proxies in front of the API (1 on Render, Railway or behind Nginx).
TRUST_PROXY=0

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Defaults to true in production. Set false only for local HTTP.
# COOKIE_SECURE=false
# COOKIE_DOMAIN=

LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_15_MIN=20
RATE_LIMIT_SENSITIVE_PER_MINUTE=20

# Email. Leave SMTP_URL empty in development: emails are logged to the console.
# Mailpit (docker compose): smtp://localhost:1025
# Production example: smtps://user:password@smtp-relay.brevo.com:465
SMTP_URL=
MAIL_FROM="Mudassir & Brothers <no-reply@mudassirbrothers.com>"

# Image storage (decision D6: Cloudinary). Find this on the Cloudinary dashboard under "API environment variable".
# Required in production. When empty (development), images are saved to UPLOAD_DIR and served at /uploads.
CLOUDINARY_URL=
CLOUDINARY_FOLDER=mudassir
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Swagger UI at /api/docs. Enabled by default outside production.
# API_DOCS_ENABLED=true

# Development seed password (npm run seed)
SEED_PASSWORD=Password123

# ---- Payments (Paystack). Card payments are offered only when the secret key is set.
# Dashboard > Settings > API Keys & Webhooks. Webhook URL: https://<api-domain>/api/v1/webhooks/paystack
PAYSTACK_SECRET_KEY=

# ---- WhatsApp Business Platform (Cloud API). Automated messages are sent only when token and phone number id are set.
# Webhook URL: https://<api-domain>/api/v1/webhooks/whatsapp (verify token below; app secret signs deliveries)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Approved templates with three body parameters: {{1}} customer first name, {{2}} reference, {{3}} status.
WHATSAPP_TEMPLATE_ORDER_UPDATE=order_update
WHATSAPP_TEMPLATE_RESERVATION_UPDATE=reservation_update

# Background jobs (reservation expiry, unattended orders). On by default; set false on extra instances if you prefer.
# JOBS_ENABLED=true
