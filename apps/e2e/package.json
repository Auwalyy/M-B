{
  "name": "@mb/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "End-to-end and accessibility tests (Playwright + axe) against a throwaway copy of the whole system",
  "scripts": {
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0"
  }
}
