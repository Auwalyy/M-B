# Production API settings. Copy to deploy/api.env (git-ignored) or into your host's secret manager.
# The API refuses to start in production with development values (see apps/api/src/config/env.ts).

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/mudassir?retryWrites=true&w=majority
WEB_URL=https://www.example.ng
# 48+ random characters, unique to production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
MAIL_FROM="Mudassir & Brothers <no-reply@example.ng>"

CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_FOLDER=mudassir

# Card payments (leave empty to offer pay-at-branch and bank transfer only)
PAYSTACK_SECRET_KEY=

# WhatsApp Cloud API (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

LOG_LEVEL=info
API_DOCS_ENABLED=false
